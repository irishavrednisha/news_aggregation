# Copy into a local .env file. NEVER commit real credentials.
# Required for the news pipeline; replace with your local database details.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=news_aggregation
DB_USER=postgres
DB_PASSWORD=

# SAFE DEFAULT. The MAX publisher refuses to send unless explicitly enabled.
# Do not enable this until Telegram moderation and database migrations are ready.
MAX_PUBLISHING_ENABLED=false

# Future integration: Telegram token and allowed moderator IDs will be added
# during the moderation-bot stage, not in this foundation commit.

# Stage 3: image collection is opt-in until tests on real sources pass.
# Keep false for normal processing until you have reviewed test results.
NEWS_IMAGES_ENABLED=false
NEWS_IMAGE_STORAGE_DIR=data/news_images

# Telegram full moderation. NEVER put real token into the repository.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
